@model Driver
@{ ViewData["Title"] = "Driver details"; }
<div class="page-heading"><div><div class="eyebrow">People</div><h1>@Model.FullName</h1><p>Driver profile and license information.</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.DriverID">Edit driver</a></div><section class="card form-card"><dl class="detail-list"><dt>Email</dt><dd>@Model.Email</dd><dt>Phone</dt><dd>@(Model.Phone ?? "—")</dd><dt>License number</dt><dd>@Model.LicenseNumber</dd><dt>License expiry</dt><dd>@Model.LicenseExpiry.ToString("MMMM d, yyyy")</dd><dt>Availability</dt><dd>@Model.Status</dd></dl></section>
