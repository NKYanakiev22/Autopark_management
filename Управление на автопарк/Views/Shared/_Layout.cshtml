@{
    var isAuthPage = ViewData["AuthPage"] as bool? == true;
    var title = ViewData["Title"]?.ToString() ?? "Fleet operations";
    var currentUser = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "DriveOps user";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08bec5" />
    <title>@title · DriveOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthPage ? "auth-body" : "")">
@if (isAuthPage)
{
    @RenderBody()
}
else
{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">D</span>DriveOps</a>
            <div class="side-label">Fleet operations</div>
            <nav class="nav-list" aria-label="Main navigation">
                <a class="nav-link @(controller == "Vehicles" ? "active" : "")" asp-controller="Vehicles" asp-action="Index"><span class="nav-icon">▣</span>Vehicles</a>
                <a class="nav-link @(controller == "Drivers" ? "active" : "")" asp-controller="Drivers" asp-action="Index"><span class="nav-icon">♙</span>Drivers</a>
                <a class="nav-link @(controller == "Maintenance" ? "active" : "")" asp-controller="Maintenance" asp-action="Index"><span class="nav-icon">⚒</span>Maintenance</a>
                <a class="nav-link @(controller == "FuelLogs" ? "active" : "")" asp-controller="FuelLogs" asp-action="Index"><span class="nav-icon">◉</span>Fuel records</a>
            </nav>
            <div class="side-bottom">
                <div class="user-card">
                    <div class="avatar">@currentUser.Substring(0, 1).ToUpperInvariant()</div>
                    <div class="user-copy"><div class="user-name">@currentUser</div><div class="user-role">@(User.IsInRole("Admin") ? "Administrator" : "Fleet team")</div></div>
                </div>
            </div>
        </aside>
        <div class="mobile-backdrop" id="mobile-backdrop"></div>
        <main class="main-area">
            <header class="topbar">
                <button class="mobile-menu" id="mobile-menu" type="button" aria-label="Open navigation">☰</button>
                <a class="mobile-brand" asp-controller="Vehicles" asp-action="Index">DriveOps</a>
                <div class="top-spacer"></div>
                <span class="current-user">@currentUser</span>
                @if (User.IsInRole("Admin")) { <span class="pill cyan">Admin</span> }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-secondary" type="submit">Sign out</button>
                </form>
            </header>
            <div class="page-wrap">
                @if (TempData["Success"] is string success) { <div class="notice success-notice" role="status">@success</div> }
                @if (TempData["Error"] is string error) { <div class="notice error-notice" role="alert">@error</div> }
                @RenderBody()
            </div>
        </main>
    </div>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
