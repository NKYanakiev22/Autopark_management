@model SettingsViewModel
@{ ViewData["Title"] = "Settings"; }
<div class="page-heading"><div><div class="eyebrow">Account</div><h1>Settings</h1><p>Update your profile and sign-in details.</p></div></div>
<section class="card form-card"><form asp-action="Settings" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid">
<div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name"/><span asp-validation-for="FullName" class="field-error"></span></div>
<div class="form-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span></div>
<div class="form-field full"><h2>Change password</h2><p>Leave these fields blank to keep your current password.</p></div>
<div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="field-error"></span></div>
<div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="field-error"></span></div>
<div class="form-field"><label asp-for="ConfirmNewPassword"></label><input asp-for="ConfirmNewPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmNewPassword" class="field-error"></span></div>
</div><div class="form-actions"><button class="btn btn-primary" type="submit">Save settings</button></div></form></section>
