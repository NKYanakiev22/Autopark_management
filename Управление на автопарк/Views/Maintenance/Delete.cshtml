@model MaintenanceRecord
@{ ViewData["Title"] = "Delete maintenance record"; }
<div class="page-heading"><div><div class="eyebrow">Service management</div><h1>Delete service record</h1><p>Confirm that this record should be removed.</p></div></div><section class="card form-card"><div class="confirm-box"><h2>@Model.Title</h2><p>@Model.Vehicle?.RegistrationNumber · @Model.ServiceDate.ToString("MMM d, yyyy") · @Model.Cost.ToString("C")</p></div><form asp-action="Delete" asp-route-id="@Model.MaintenanceRecordID" method="post" class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-danger" type="submit">Delete record</button></form></section>
