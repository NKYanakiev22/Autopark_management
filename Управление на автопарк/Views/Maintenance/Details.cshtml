@model MaintenanceRecord
@{ ViewData["Title"] = "Maintenance details"; }
<div class="page-heading"><div><div class="eyebrow">Service management</div><h1>@Model.Title</h1><p>@Model.Vehicle?.RegistrationNumber · @Model.ServiceDate.ToString("MMM d, yyyy")</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.MaintenanceRecordID">Edit record</a></div><section class="card form-card"><dl class="detail-list"><dt>Vehicle</dt><dd>@Model.Vehicle?.RegistrationNumber</dd><dt>Service date</dt><dd>@Model.ServiceDate.ToString("MMMM d, yyyy")</dd><dt>Cost</dt><dd>@Model.Cost.ToString("C")</dd><dt>Status</dt><dd>@Model.Status</dd><dt>Notes</dt><dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd></dl></section>
