@model IReadOnlyList<MaintenanceRecord>
@{ ViewData["Title"] = "Maintenance"; }
<div class="page-heading"><div><div class="eyebrow">Service management</div><h1>Maintenance</h1><p>Track repairs and upcoming service for your vehicles.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add service record</a></div>
<section class="card"><div class="toolbar"><span class="record-count">@Model.Count service records</span></div><div class="table-wrap"><table><thead><tr><th>Service / issue</th><th>Vehicle</th><th>Service date</th><th>Cost</th><th>Status</th><th></th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="empty-state">No maintenance records yet.</td></tr> }
@foreach (var item in Model) { <tr><td class="primary-cell">@item.Title</td><td>@item.Vehicle?.RegistrationNumber</td><td>@item.ServiceDate.ToString("MMM d, yyyy")</td><td>@item.Cost.ToString("C")</td><td><span class="pill @(item.Status == "Completed" ? "" : "amber")">@item.Status</span></td><td class="row-actions"><a asp-action="Details" asp-route-id="@item.MaintenanceRecordID">View</a><a asp-action="Edit" asp-route-id="@item.MaintenanceRecordID">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.MaintenanceRecordID">Delete</a></td></tr> }
</tbody></table></div></section>
