@model FuelLog
@{ ViewData["Title"] = "Fuel record"; }
<div class="page-heading"><div><div class="eyebrow">Fleet costs</div><h1>Fuel record</h1><p>@Model.Vehicle?.RegistrationNumber · @Model.FuelDate.ToString("MMM d, yyyy")</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.FuelLogID">Edit record</a></div><section class="card form-card"><dl class="detail-list"><dt>Vehicle</dt><dd>@Model.Vehicle?.RegistrationNumber</dd><dt>Date</dt><dd>@Model.FuelDate.ToString("MMMM d, yyyy")</dd><dt>Litres</dt><dd>@Model.Litres.ToString("N2") L</dd><dt>Total cost</dt><dd>@Model.TotalCost.ToString("C")</dd></dl></section>
