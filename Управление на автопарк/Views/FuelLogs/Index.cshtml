@model IReadOnlyList<FuelLog>
@{ ViewData["Title"] = "Fuel records"; }
<div class="page-heading"><div><div class="eyebrow">Fleet costs</div><h1>Fuel records</h1><p>Track refueling activity and costs by vehicle.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add fuel record</a></div>
<section class="card"><div class="toolbar"><span class="record-count">@Model.Count records</span></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Vehicle</th><th>Litres</th><th>Total cost</th><th></th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="5" class="empty-state">No fuel records yet.</td></tr> }
@foreach (var item in Model) { <tr><td>@item.FuelDate.ToString("MMM d, yyyy")</td><td class="primary-cell">@item.Vehicle?.RegistrationNumber</td><td>@item.Litres.ToString("N2") L</td><td>@item.TotalCost.ToString("C")</td><td class="row-actions"><a asp-action="Details" asp-route-id="@item.FuelLogID">View</a><a asp-action="Edit" asp-route-id="@item.FuelLogID">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.FuelLogID">Delete</a></td></tr> }
</tbody></table></div></section>
