@model FuelLog
@{ ViewData["Title"] = "Edit fuel record"; }
<div class="page-heading"><div><div class="eyebrow">Fleet costs</div><h1>Edit fuel record</h1><p>Update this refueling record.</p></div></div><section class="card form-card"><form asp-action="Edit" asp-route-id="@Model.FuelLogID" method="post"><input asp-for="FuelLogID" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="VehicleID"></label><select asp-for="VehicleID" asp-items="ViewBag.VehicleID"><option value="">Select a vehicle</option></select><span asp-validation-for="VehicleID" class="field-error"></span></div><div class="form-field"><label asp-for="FuelDate"></label><input asp-for="FuelDate" type="date" /><span asp-validation-for="FuelDate" class="field-error"></span></div><div class="form-field"><label asp-for="Litres"></label><input asp-for="Litres" step="0.01" /><span asp-validation-for="Litres" class="field-error"></span></div><div class="form-field"><label asp-for="TotalCost"></label><input asp-for="TotalCost" step="0.01" /><span asp-validation-for="TotalCost" class="field-error"></span></div></div><div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save changes</button></div></form></section>
