@model FuelLog
@{ ViewData["Title"] = "Delete fuel record"; }
<div class="page-heading"><div><div class="eyebrow">Fleet costs</div><h1>Delete fuel record</h1><p>Confirm that this fuel record should be removed.</p></div></div><section class="card form-card"><div class="confirm-box"><h2>@Model.Vehicle?.RegistrationNumber</h2><p>@Model.FuelDate.ToString("MMM d, yyyy") · @Model.Litres.ToString("N2") L · @Model.TotalCost.ToString("C")</p></div><form asp-action="Delete" asp-route-id="@Model.FuelLogID" method="post" class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-danger" type="submit">Delete record</button></form></section>
