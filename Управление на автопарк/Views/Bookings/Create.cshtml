@model VehicleBooking
@{ ViewData["Title"] = "Book a vehicle"; }
<div class="page-heading"><div><div class="eyebrow">Vehicle scheduling</div><h1>Book a vehicle</h1><p>Send a request to reserve an active fleet vehicle.</p></div></div>
<section class="card form-card"><form asp-action="Create" method="post"><div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="VehicleID">Vehicle</label><select asp-for="VehicleID" asp-items="ViewBag.VehicleID"><option value="">Select an active vehicle</option></select><span asp-validation-for="VehicleID" class="field-error"></span></div><div class="form-field"><label asp-for="Purpose"></label><input asp-for="Purpose" placeholder="e.g. Customer visit"/><span asp-validation-for="Purpose" class="field-error"></span></div><div class="form-field"><label asp-for="StartAt"></label><input asp-for="StartAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="StartAt" class="field-error"></span></div><div class="form-field"><label asp-for="EndAt"></label><input asp-for="EndAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="EndAt" class="field-error"></span></div></div><div class="form-actions"><a class="btn btn-secondary" asp-controller="Vehicles" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Submit booking</button></div></form></section>
