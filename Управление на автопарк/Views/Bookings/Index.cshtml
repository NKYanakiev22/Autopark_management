@model IReadOnlyList<VehicleBooking>
@{ ViewData["Title"] = "Vehicle bookings"; }
<div class="page-heading"><div><div class="eyebrow">Vehicle scheduling</div><h1>@(User.IsInRole("Admin") ? "All bookings" : "My bookings")</h1><p>@(User.IsInRole("Admin") ? "Review and manage vehicle booking requests." : "Book an active fleet vehicle and track your requests.")</p></div><a class="btn btn-primary" asp-action="Create">＋ Book a vehicle</a></div>
<section class="card"><div class="toolbar"><span class="record-count">@Model.Count bookings</span></div><div class="table-wrap"><table><thead><tr><th>Vehicle</th><th>Requested by</th><th>Purpose</th><th>Schedule</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="empty-state">No bookings yet. Create a request to reserve a vehicle.</td></tr> }
@foreach (var item in Model) { var submitter = User.IsInRole("Admin") && ((Dictionary<string, (string Name, string Email)>)ViewBag.Submitters).TryGetValue(item.UserId, out var found) ? found : (Name: "Unknown user", Email: ""); <tr><td class="primary-cell">@item.Vehicle?.RegistrationNumber · @item.Vehicle?.Make @item.Vehicle?.Model</td><td>@(User.IsInRole("Admin") ? $"{submitter.Name} ({submitter.Email})" : "You")</td><td>@item.Purpose</td><td>@item.StartAt.ToString("MMM d, yyyy h:mm tt") – @item.EndAt.ToString("h:mm tt")</td><td><span class="pill @(item.Status == "Pending" ? "amber" : "")">@item.Status</span></td><td class="row-actions">
@if (User.IsInRole("Admin") && item.Status == "Pending") { <form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@item.VehicleBookingID"/><input type="hidden" name="status" value="Approved"/><button class="table-button" type="submit">Approve</button></form> }
@if ((User.IsInRole("Admin") && item.Status != "Cancelled") || (item.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && item.Status != "Cancelled")) { <form asp-action="@(User.IsInRole("Admin") ? "SetStatus" : "Cancel")" method="post"><input type="hidden" name="id" value="@item.VehicleBookingID"/>@if (User.IsInRole("Admin")) { <input type="hidden" name="status" value="Cancelled"/> }<button class="table-button danger-link" type="submit">Cancel</button></form> }
</td></tr> }
</tbody></table></div></section>
