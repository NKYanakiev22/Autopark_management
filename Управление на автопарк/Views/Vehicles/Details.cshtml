@model Vehicle
@{ ViewData["Title"] = "Vehicle details"; }
<div class="page-heading"><div><div class="eyebrow">Fleet inventory</div><h1>@Model.Make @Model.Model</h1><p>Vehicle details and activity.</p></div>@if (User.IsInRole("Admin")) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.VehicleID">Edit vehicle</a> } else { <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create" asp-route-vehicleId="@Model.VehicleID">Book this vehicle</a> }</div>
<div class="detail-grid"><section class="card form-card"><h2>Vehicle information</h2><dl class="detail-list"><dt>Registration</dt><dd>@Model.RegistrationNumber</dd><dt>Year</dt><dd>@Model.ManufactureYear</dd><dt>Mileage</dt><dd>@Model.CurrentMileage.ToString("N0") mi</dd><dt>Status</dt><dd>@Model.Status</dd></dl></section>@if (User.IsInRole("Admin")) { <section class="card form-card"><h2>Service history</h2><p>@Model.MaintenanceRecords.Count maintenance records</p><p>@Model.FuelLogs.Count fuel records</p><a asp-controller="FuelLogs" asp-action="Index">View fuel records</a></section> }</div>
